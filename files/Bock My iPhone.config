[General]
bypass-system = true

[Rule]
# iCloud / Find My related
DOMAIN-SUFFIX,icloud.com,REJECT
DOMAIN-SUFFIX,icloud-content.com,REJECT
DOMAIN-SUFFIX,icloud.com.cn,REJECT

# Apple ID / identity
DOMAIN-SUFFIX,appleid.com,REJECT
DOMAIN-SUFFIX,appleid.apple.com,REJECT
DOMAIN-SUFFIX,identity.apple.com,REJECT

# Device activation / software services
DOMAIN,gs.apple.com,REJECT
DOMAIN-SUFFIX,activation.apple.com,REJECT
DOMAIN-SUFFIX,setup.icloud.com,REJECT
DOMAIN-SUFFIX,init.itunes.apple.com,REJECT

# Explicit hosts from the original list
DOMAIN,fmipmobile.icloud.com,REJECT
DOMAIN,fmip.icloud.com,REJECT
DOMAIN,gs.apple.com,REJECT
DOMAIN,identity.apple.com,REJECT
DOMAIN,setup.icloud.com,REJECT
DOMAIN,appleid.apple.com,REJECT
DOMAIN,ax.init.itunes.apple.com,REJECT
DOMAIN,icloud.com,REJECT

FINAL,DIRECT